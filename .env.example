# Copy to .env.local; the startup command loads it automatically.
# Environment variables already set in the shell take precedence.
BUAA_DATA_DIR=./data
BUAA_LLM_BASE_URL=
BUAA_LLM_MODEL=
BUAA_LLM_API_KEY=
# Installed Chrome is used by default. Alternatives: msedge, chromium.
BUAA_BROWSER_CHANNEL=chrome
