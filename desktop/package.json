{
  "name": "buaa-learn-desktop",
  "productName": "BUAA Learn",
  "version": "0.2.0",
  "description": "BUAA Learn 课程学习助手",
  "author": "fyzzzz05",
  "license": "MIT",
  "main": "main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "icons": "node make-icons.cjs",
    "pack": "npm run icons && electron-builder --dir --publish never",
    "dist:mac": "npm run icons && electron-builder --mac dmg --publish never",
    "dist:win": "npm run icons && electron-builder --win nsis --x64 --publish never",
    "test": "node --test test-*.cjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.fyzzzz05.buaa-learn",
    "productName": "BUAA Learn",
    "directories": { "output": "../dist/desktop", "buildResources": "assets" },
    "files": ["main.cjs", "navigation.cjs", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
    "extraResources": [{ "from": "../dist/backend/buaa-backend", "to": "backend", "filter": ["**/*"] }],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.png",
      "identity": null,
      "artifactName": "BUAA-Learn-${version}-mac-${arch}.${ext}"
    },
    "dmg": { "title": "BUAA Learn", "sign": false },
    "win": {
      "icon": "assets/icon.png",
      "artifactName": "BUAA-Learn-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
